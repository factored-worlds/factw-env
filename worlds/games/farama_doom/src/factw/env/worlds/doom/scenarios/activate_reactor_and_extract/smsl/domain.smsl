smsl "0.2";

event observed_active(value: bool?);
event observed_alive(value: bool?);
event observed_health_low(value: bool?);
event observed_ammo_low(value: bool?);
event observed_has_ammo(value: bool?);
event observed_armored(value: bool?);
event observed_threat(value: bool?);
event observed_fireball_visible(value: bool?);
event observed_visible_fireball_count(value: uint?);
event observed_incoming_fireball(value: bool?);
event observed_fireball_pass_side(value: string?);
event observed_threats_clear(value: bool?);
event observed_has_key(value: bool?);
event observed_door_open(value: bool?);
event observed_at_exit(value: bool?);
event observed_reactor_active(value: bool?);
event observed_near_door(value: bool?);
event observed_near_reactor(value: bool?);
event observed_health_available(value: bool?);
event observed_ammo_available(value: bool?);
event observed_reserve_health_available(value: bool?);
event observed_extraction_open(value: bool?);
event observed_armor_available(value: bool?);
event observed_region(value: string?);
event skill_finished(skill: string, status: string);

branch Scene {
    fact active: [false, true] = unknown;
    fact alive: [false, true] = unknown;
    fact health_low: [false, true] = unknown;
    fact ammo_low: [false, true] = unknown;
    fact has_ammo: [false, true] = unknown;
    fact armored: [false, true] = unknown;
    fact threat: [false, true] = unknown;
    fact fireball_visible: [false, true] = unknown;
    fact visible_fireball_count: uint[0..4294967295] = unknown;
    fact incoming_fireball: [false, true] = unknown;
    fact fireball_pass_side: ["none", "left", "right", "center"] = unknown;
    fact threats_clear: [false, true] = unknown;
    fact has_key: [false, true] = unknown;
    fact door_open: [false, true] = unknown;
    fact at_exit: [false, true] = unknown;
    fact reactor_active: [false, true] = unknown;
    fact near_door: [false, true] = unknown;
    fact near_reactor: [false, true] = unknown;
    fact health_available: [false, true] = unknown;
    fact ammo_available: [false, true] = unknown;
    fact reserve_health_available: [false, true] = unknown;
    fact extraction_open: [false, true] = unknown;
    fact armor_available: [false, true] = unknown;
    fact region: ["supply", "arena", "reactor", "extraction"] = unknown;
    data evidence: event = null;
    data last_skill: string = "";
    data last_outcome: string = "";

    action heal() when self.active and self.alive and self.health_low and self.health_available outcomes(skill_finished);
    action resupply() when self.active and self.alive and self.ammo_low and self.ammo_available outcomes(skill_finished);
    action equip_armor() when self.active and self.alive and not self.armored and self.armor_available outcomes(skill_finished);
    action heal_reserve() when self.active and self.alive and self.health_low and self.door_open and self.reserve_health_available outcomes(skill_finished);
    action dodge_to_open_side() when self.active and self.alive and self.incoming_fireball and self.visible_fireball_count > 0 and self.region == "supply" outcomes(skill_finished);
    action dodge_left() when self.active and self.alive and self.incoming_fireball and self.visible_fireball_count > 0 and self.region != "supply" and (self.fireball_pass_side == "right" or self.fireball_pass_side == "center") outcomes(skill_finished);
    action dodge_right() when self.active and self.alive and self.incoming_fireball and self.visible_fireball_count > 0 and self.region != "supply" and self.fireball_pass_side == "left" outcomes(skill_finished);
    action engage() when self.active and self.alive and self.has_ammo and self.threat outcomes(skill_finished);
    action advance_arena() when self.active and self.alive and self.region == "supply" and not self.threat outcomes(skill_finished);
    action search() when self.active and self.alive and self.region == "arena" and self.has_ammo and not self.threats_clear and not self.threat outcomes(skill_finished);
    action collect_key() when self.active and self.alive and self.region == "arena" and self.threats_clear and not self.has_key and not self.threat outcomes(skill_finished);
    action approach_door() when self.active and self.alive and self.has_key and not self.near_door and not self.door_open and not self.threat outcomes(skill_finished);
    action open_door() when self.active and self.alive and self.has_key and self.near_door and not self.door_open and not self.threat outcomes(skill_finished);
    action approach_reactor() when self.active and self.alive and self.has_key and self.door_open and self.threats_clear and not self.near_reactor and not self.reactor_active and not self.threat outcomes(skill_finished);
    action activate_reactor() when self.active and self.alive and self.has_key and self.door_open and self.threats_clear and self.near_reactor and not self.reactor_active outcomes(skill_finished);
    action extract() when self.active and self.alive and self.has_key and self.door_open and self.reactor_active and self.extraction_open and self.threats_clear and not self.at_exit outcomes(skill_finished);
    action wait() when self.active and self.alive and self.at_exit outcomes(skill_finished);

    on observed_active when payload.value != null set(active=payload.value, evidence=event.ref);
    on observed_active when payload.value == null set(active=unknown);
    on observed_alive when payload.value != null set(alive=payload.value);
    on observed_alive when payload.value == null set(alive=unknown);
    on observed_health_low when payload.value != null set(health_low=payload.value);
    on observed_health_low when payload.value == null set(health_low=unknown);
    on observed_ammo_low when payload.value != null set(ammo_low=payload.value);
    on observed_ammo_low when payload.value == null set(ammo_low=unknown);
    on observed_has_ammo when payload.value != null set(has_ammo=payload.value);
    on observed_has_ammo when payload.value == null set(has_ammo=unknown);
    on observed_armored when payload.value != null set(armored=payload.value);
    on observed_armored when payload.value == null set(armored=unknown);
    on observed_threat when payload.value != null set(threat=payload.value);
    on observed_threat when payload.value == null set(threat=unknown);
    on observed_fireball_visible when payload.value != null set(fireball_visible=payload.value);
    on observed_fireball_visible when payload.value == null set(fireball_visible=unknown);
    on observed_visible_fireball_count when payload.value != null set(visible_fireball_count=payload.value);
    on observed_visible_fireball_count when payload.value == null set(visible_fireball_count=unknown);
    on observed_incoming_fireball when payload.value != null set(incoming_fireball=payload.value);
    on observed_incoming_fireball when payload.value == null set(incoming_fireball=unknown);
    on observed_fireball_pass_side when payload.value != null set(fireball_pass_side=payload.value);
    on observed_fireball_pass_side when payload.value == null set(fireball_pass_side=unknown);
    on observed_threats_clear when payload.value != null set(threats_clear=payload.value);
    on observed_threats_clear when payload.value == null set(threats_clear=unknown);
    on observed_has_key when payload.value != null set(has_key=payload.value);
    on observed_has_key when payload.value == null and self.has_key == false set(has_key=unknown);
    on observed_door_open when payload.value != null set(door_open=payload.value);
    on observed_door_open when payload.value == null and self.door_open == false set(door_open=unknown);
    on observed_at_exit when payload.value != null set(at_exit=payload.value);
    on observed_at_exit when payload.value == null set(at_exit=unknown);
    on observed_reactor_active when payload.value != null set(reactor_active=payload.value);
    on observed_reactor_active when payload.value == null and self.reactor_active == false set(reactor_active=unknown);
    on observed_near_door when payload.value != null set(near_door=payload.value);
    on observed_near_door when payload.value == null set(near_door=unknown);
    on observed_near_reactor when payload.value != null set(near_reactor=payload.value);
    on observed_near_reactor when payload.value == null set(near_reactor=unknown);
    on observed_health_available when payload.value != null set(health_available=payload.value);
    on observed_health_available when payload.value == null set(health_available=unknown);
    on observed_ammo_available when payload.value != null set(ammo_available=payload.value);
    on observed_ammo_available when payload.value == null set(ammo_available=unknown);
    on observed_reserve_health_available when payload.value != null set(reserve_health_available=payload.value);
    on observed_reserve_health_available when payload.value == null set(reserve_health_available=unknown);
    on observed_extraction_open when payload.value != null set(extraction_open=payload.value);
    on observed_extraction_open when payload.value == null and self.extraction_open == false set(extraction_open=unknown);
    on observed_armor_available when payload.value != null set(armor_available=payload.value);
    on observed_armor_available when payload.value == null set(armor_available=unknown);
    on observed_region when payload.value != null set(region=payload.value);
    on observed_region when payload.value == null set(region=unknown);
    on skill_finished set(last_skill=payload.skill, last_outcome=payload.status);
}
