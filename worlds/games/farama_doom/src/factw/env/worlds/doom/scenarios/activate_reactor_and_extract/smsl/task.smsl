smsl "0.2";
event progress(active: bool, has_key: bool?, door_open: bool?, reactor_active: bool?, threats_clear: bool?, at_exit: bool?);
branch Task {
    fact active: [false, true] = unknown;
    fact key_observed: [false, true] = false;
    fact door_observed: [false, true] = false;
    fact reactor_observed: [false, true] = false;
    fact cleared_observed: [false, true] = false;
    fact exit_observed: [false, true] = false;
    derive succeeded: [false, true] = self.key_observed and self.door_observed and self.reactor_observed and self.cleared_observed and self.exit_observed;
    on progress set(active=payload.active,
        key_observed=self.key_observed or payload.has_key == true,
        door_observed=self.door_observed or payload.door_open == true,
        reactor_observed=self.reactor_observed or payload.reactor_active == true,
        cleared_observed=self.cleared_observed or payload.threats_clear == true,
        exit_observed=self.exit_observed or payload.at_exit == true);
}
