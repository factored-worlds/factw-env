#include "zcommon.acs"

global int 0:reward;
global int 1:has_key;
global int 2:door_passable;
global int 3:exited;
global int 4:near_door;
global int 5:room_index;

script 1 ENTER
{
    reward = 0;
    has_key = 0;
    door_passable = 0;
    exited = 0;
    near_door = 0;
    room_index = 1;
    while (GetActorProperty(0, APROP_Health) > 0)
    {
        int x = GetActorX(0);
        int y = GetActorY(0);
        has_key = CheckInventory("BlueCard") > 0;
        if (GetSectorCeilingZ(10, 416.0, 128.0) >= 64.0)
            door_passable = 1;
        near_door = x >= 320.0 && x <= 448.0 && y >= 96.0 && y <= 160.0;
        room_index = 1;
        if (x >= 448.0) room_index = 2;
        if (x >= 704.0 && y >= 96.0 && y <= 160.0 && has_key && door_passable)
        {
            exited = 1;
            reward += 1.0;
            Exit_Normal(0);
            terminate;
        }
        Delay(1);
    }
}

script 2 (void)
{
    if (CheckInventory("BlueCard") > 0)
        Door_Open(10, 16);
}
