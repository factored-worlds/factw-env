{
  "type": "object",
  "properties": {
    "schema": {
      "const": "doom.refinement-request/1"
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "original_goal": {
      "type": "object",
      "properties": {
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "document": {
          "type": "object",
          "properties": {
            "schema": {
              "const": "doom.refinement-original-goal/1"
            },
            "id": {
              "$ref": "#/$defs/id"
            },
            "scenario_id": {
              "type": "string",
              "minLength": 1
            },
            "scenario_behavior_revision": {
              "type": "integer",
              "minimum": 1
            },
            "text": {
              "type": "string",
              "minLength": 1
            },
            "clauses": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "$ref": "#/$defs/id"
                  },
                  "meaning": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "meaning"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            },
            "agent_completion": {
              "type": "string",
              "minLength": 1
            },
            "temporal_scope": {
              "type": "string",
              "minLength": 1
            },
            "revision_rule": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "schema",
            "id",
            "scenario_id",
            "scenario_behavior_revision",
            "text",
            "clauses",
            "agent_completion",
            "temporal_scope",
            "revision_rule"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "sha256",
        "document"
      ],
      "additionalProperties": false
    },
    "observation_streams": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "modality": {
            "type": "string",
            "minLength": 1
          },
          "encoding": {
            "type": "string",
            "minLength": 1
          },
          "source_id": {
            "type": "string",
            "minLength": 1
          },
          "time_basis": {
            "type": "object",
            "properties": {
              "kind": {
                "enum": [
                  "ordinal",
                  "relative_time"
                ]
              },
              "unit": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "unit"
            ],
            "additionalProperties": false
          },
          "samples": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "ordinal": {
                  "type": "integer",
                  "minimum": 0
                },
                "relative_time": {
                  "anyOf": [
                    {
                      "type": "number",
                      "minimum": 0
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "payload_sha256": {
                  "$ref": "#/$defs/sha256"
                },
                "content": {
                  "oneOf": [
                    {
                      "type": "object",
                      "properties": {
                        "text": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "text"
                      ],
                      "additionalProperties": false
                    },
                    {
                      "type": "object",
                      "properties": {
                        "asset_id": {
                          "type": "string",
                          "minLength": 1
                        }
                      },
                      "required": [
                        "asset_id"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "required": [
                "id",
                "ordinal",
                "relative_time",
                "payload_sha256",
                "content"
              ],
              "additionalProperties": false
            },
            "minItems": 1
          },
          "gaps": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "after_sample": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "before_sample": {
                  "anyOf": [
                    {
                      "type": "string",
                      "minLength": 1
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "reason": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "required": [
                "after_sample",
                "before_sample",
                "reason"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "modality",
          "encoding",
          "source_id",
          "time_basis",
          "samples",
          "gaps"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    },
    "guidance": {
      "type": "object",
      "properties": {
        "prior_smsl_documents": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/document"
          }
        },
        "existing_facts": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "meaning": {
                "type": "string",
                "minLength": 1
              },
              "value": {},
              "source_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "reference",
              "meaning",
              "value",
              "source_id"
            ],
            "additionalProperties": false
          }
        },
        "primitive_descriptions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              },
              "argument_schema": {
                "type": "object"
              }
            },
            "required": [
              "id",
              "description",
              "argument_schema"
            ],
            "additionalProperties": false
          }
        },
        "recorded_commands": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "ordinal": {
                "type": "integer",
                "minimum": 0
              },
              "relative_time": {
                "anyOf": [
                  {
                    "type": "number",
                    "minimum": 0
                  },
                  {
                    "type": "null"
                  }
                ]
              },
              "command": {
                "type": "object"
              },
              "aligned_observations": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/sample_reference"
                }
              }
            },
            "required": [
              "id",
              "ordinal",
              "relative_time",
              "command",
              "aligned_observations"
            ],
            "additionalProperties": false
          }
        },
        "partial_hierarchies": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "parent": {
                "type": "string",
                "minLength": 1
              },
              "children": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "meaning": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "parent",
              "children",
              "meaning"
            ],
            "additionalProperties": false
          }
        },
        "declared_constraints": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "required": [],
      "additionalProperties": false
    }
  },
  "required": [
    "schema",
    "id",
    "original_goal",
    "observation_streams"
  ],
  "additionalProperties": false,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Proposed Doom refinement request envelope",
  "description": "Definition only. A matching shape grants no information rights or modality support; host projection and referential checks are separate.",
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "reference": {
      "type": "object",
      "properties": {
        "document_id": {
          "$ref": "#/$defs/id"
        },
        "address": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "document_id",
        "address"
      ],
      "additionalProperties": false
    },
    "condition": {
      "type": "object",
      "properties": {
        "document_id": {
          "$ref": "#/$defs/id"
        },
        "branch": {
          "type": "string",
          "minLength": 1
        },
        "expression": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "document_id",
        "branch",
        "expression"
      ],
      "additionalProperties": false
    },
    "sample_reference": {
      "type": "object",
      "properties": {
        "stream_id": {
          "$ref": "#/$defs/id"
        },
        "sample_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "stream_id",
        "sample_id"
      ],
      "additionalProperties": false
    },
    "document": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "role": {
          "enum": [
            "model",
            "abstraction",
            "execution",
            "system",
            "application"
          ]
        },
        "serialization": {
          "enum": [
            "smsl_text",
            "smsl_json"
          ]
        },
        "source": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        }
      },
      "required": [
        "id",
        "role",
        "serialization",
        "source",
        "sha256"
      ],
      "additionalProperties": false
    }
  }
}
